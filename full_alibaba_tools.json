          - chatToken (string) (required) — 当前会话的鉴权 token，用于校验发送方的沟通权限
          - chatTypeEnum (string) (required) — 会话类型。可选值：SINGLE（单聊，此时 receiverAliID 必填）、GROUP（群聊，此时需指定 conversationID）
          - clearRedPoint (boolean) — 是否需要清除发送者会话红点,默认为true
          - clientInfo (string) — 客户端信息,默认为服务端发送
          - content (string) — 消息正文内容。当 messageType 为 CUSTOMER_TEXT 时传纯文本；当 messageType 为 CARD 时传结构化 JSON 字符串
          - conversationID (string) — 会话ID,为空时系统自动创建
          - delayTimeEnum (string) — 需要延迟发送消息时,消息延迟时间,为空时立即发送
          - deviceParam (object) — 设备信息
              - cna (string) — web cna
              - ip (string) — 设备ip
              - utdid (string) — 设备id
          - entranceSource (string) (required) — 消息发送入口
          - excludeAliID (number[])
          - extParams (object) — 扩展参数
          - ip (string) — 发送人IP地址
          - messageScene (number) —  消息场景,为空时候默认与messageType值相同
          - messageType (string) (required) — 消息类型(普通文本消息:CUSTOMER_TEXT)
          - needReverseCheck (boolean) — 是否需要反向校验（访客营销消息发送需要特殊处理）
          - operatorLoginId (string) — 代回复人loginId
          - receiverAliID (number[]) (required)
          - relatedName (string) — 已废弃，请改用 extParams 传递关联触发名称
          - relatedType (string) — 消息关联类型标识，用于关联消息的分类
          - requestFrom (string) — 请求来源，自动生成
          - safeFilter (boolean) — 是否需要走风控流程,默认为true
          - sendAppTypeEnum (string) — 消息发送端类型标识。可选值:server
          - terminalType (string) — 端型
          - visParam (object) — V公司消息参数
              - firstMsg (boolean) — 是否是首条消息
              - receiverSite (string) — 如果是v账号，需要传v账号站点
